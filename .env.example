# Copy to .env and adjust. Every variable here is validated at boot by
# src/infrastructure/config/env.ts — a missing or malformed value fails fast.

# --- Database (docker compose service "db") ---
# PostGIS image used by docker compose and by the integration tests. The default is
# multi-arch; the official postgis/postgis publishes amd64 only.
POSTGIS_IMAGE=imresamu/postgis:17-3.5
# Host port for the database container. Keep it in sync with DATABASE_URL below.
POSTGRES_PORT=5434
DATABASE_URL=postgres://artesanal:artesanal@localhost:5434/artesanal

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret!!
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage (docker compose service "storage", S3-compatible) ---
# Swapping MinIO for R2/S3/Supabase later is a change of these values only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artesanal
S3_ACCESS_KEY_ID=artesanal
S3_SECRET_ACCESS_KEY=artesanal123
S3_PUBLIC_URL=http://localhost:9000/artesanal

# --- Public app URL, used in metadata and the PWA manifest ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
